{
  "Storage": {
    "UseInMemory": false
  },
  "ProxyTrust": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Persistence": {
    "CommandTimeoutSeconds": 30
  },
  "Idempotency": {
    "RetentionHours": 24
  },
  "RequestLimits": {
    "MaxRequestBodyBytes": 16384,
    "MaxRequestLineBytes": 8192,
    "MaxRequestHeadersTotalBytes": 16384,
    "MaxRequestHeaderCount": 64,
    "RequestHeadersTimeoutSeconds": 10,
    "RequestTimeoutSeconds": 15
  },
  "RateLimiting": {
    "Anonymous": {
      "Algorithm": "FixedWindow",
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "AuthenticationRegistration": {
      "Algorithm": "SlidingWindow",
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "AuthenticationSignIn": {
      "Algorithm": "SlidingWindow",
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "AuthenticationSession": {
      "Algorithm": "SlidingWindow",
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Authenticated": {
      "Algorithm": "FixedWindow",
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "UrlCreation": {
      "Algorithm": "TokenBucket",
      "PermitLimit": 20,
      "TokensPerPeriod": 20,
      "ReplenishmentPeriodSeconds": 60
    },
    "ApiKey": {
      "Algorithm": "TokenBucket",
      "PermitLimit": 600,
      "TokensPerPeriod": 600,
      "ReplenishmentPeriodSeconds": 60
    }
  },
  "Redis": {
    "ConnectionString": "",
    "KeyPrefix": "",
    "ConnectTimeoutMilliseconds": 2000,
    "OperationTimeoutMilliseconds": 1000,
    "ConnectRetryCount": 2,
    "ReconnectBaseDelayMilliseconds": 1000,
    "ReconnectMaxDelayMilliseconds": 5000
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "",
    "Password": "",
    "UseTls": false,
    "TlsServerName": "",
    "ClientProvidedName": "url-shortener-api",
    "ConnectionTimeoutMilliseconds": 5000,
    "OperationTimeoutMilliseconds": 5000,
    "RequestedHeartbeatSeconds": 30,
    "NetworkRecoveryIntervalMilliseconds": 5000,
    "ConsumerPrefetchCount": 32,
    "DeliveryLimit": 5,
    "RetryBaseDelayMilliseconds": 250,
    "ExchangeName": "url-shortener.events.v1",
    "QueueName": "url-shortener.analytics.clicks.v1",
    "RoutingKey": "analytics.click.v1",
    "DeadLetterExchangeName": "url-shortener.events.dead.v1",
    "DeadLetterQueueName": "url-shortener.analytics.clicks.dead.v1",
    "DeadLetterRoutingKey": "analytics.click.v1.failed"
  },
  "ClickEvents": {
    "VisitorIdentityHmacKeyBase64": ""
  },
  "ShortUrlLifecycle": {
    "SoftDeleteRetentionDays": 30
  },
  "PublicUrls": {
    "BaseUrl": "",
    "CustomDomainScheme": "https"
  },
  "CustomDomains": {
    "VerificationRecordLabel": "_urlshortener-verification",
    "VerificationValuePrefix": "urlshortener-verification=",
    "DnsOverHttpsEndpoint": "https://cloudflare-dns.com/dns-query",
    "LookupTimeoutSeconds": 5,
    "ReservedHosts": []
  },
  "Identity": {
    "PublicRegistrationEnabled": true,
    "RequireSecureCookies": true,
    "JwtIssuer": "UrlShortener.Api",
    "JwtAudience": "UrlShortener.Client",
    "JwtSigningKeyBase64": "",
    "JwtClockSkewSeconds": 30,
    "AllowedOrigins": [
      "https://localhost:4200",
      "http://localhost:4200"
    ],
    "PasswordRequiredLength": 12,
    "PasswordRequiredUniqueChars": 4,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "AccessTokenLifetimeMinutes": 10,
    "RefreshTokenLifetimeDays": 30,
    "RefreshTokenAbsoluteLifetimeDays": 90
  },
  "Serilog": {
    "MinimumLevel": "Information"
  }
}
