{
  "Storage": {
    "UseInMemory": false
  },
  "Persistence": {
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 5,
    "CommandTimeoutSeconds": 30
  },
  "RateLimiting": {
    "CreatePerMinuteLimit": 20
  },
  "Redis": {
    "ConnectionString": "",
    "KeyPrefix": "",
    "ConnectTimeoutMilliseconds": 2000,
    "OperationTimeoutMilliseconds": 1000,
    "ConnectRetryCount": 2,
    "ReconnectBaseDelayMilliseconds": 1000,
    "ReconnectMaxDelayMilliseconds": 5000
  },
  "ShortUrlLifecycle": {
    "SoftDeleteRetentionDays": 30
  },
  "PublicUrls": {
    "BaseUrl": ""
  },
  "Identity": {
    "PublicRegistrationEnabled": true,
    "RequireSecureCookies": true,
    "JwtIssuer": "UrlShortener.Api",
    "JwtAudience": "UrlShortener.Client",
    "JwtSigningKeyBase64": "",
    "JwtClockSkewSeconds": 30,
    "AllowedOrigins": [
      "https://localhost:4200",
      "http://localhost:4200"
    ],
    "PasswordRequiredLength": 12,
    "PasswordRequiredUniqueChars": 4,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "AccessTokenLifetimeMinutes": 10,
    "RefreshTokenLifetimeDays": 30,
    "RefreshTokenAbsoluteLifetimeDays": 90
  },
  "AuthenticationRateLimiting": {
    "RegistrationPerMinuteLimit": 5,
    "SignInPerMinuteLimit": 10,
    "RefreshPerMinuteLimit": 30
  },
  "Serilog": {
    "MinimumLevel": "Information"
  }
}
