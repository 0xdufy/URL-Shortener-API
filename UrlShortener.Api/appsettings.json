{
  "Storage": {
    "UseInMemory": false
  },
  "ProxyTrust": {
    "Enabled": false,
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Persistence": {
    "MaxRetryCount": 3,
    "MaxRetryDelaySeconds": 5,
    "CommandTimeoutSeconds": 30
  },
  "RateLimiting": {
    "Anonymous": {
      "Algorithm": "FixedWindow",
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "AuthenticationRegistration": {
      "Algorithm": "SlidingWindow",
      "PermitLimit": 5,
      "WindowSeconds": 60
    },
    "AuthenticationSignIn": {
      "Algorithm": "SlidingWindow",
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "AuthenticationSession": {
      "Algorithm": "SlidingWindow",
      "PermitLimit": 30,
      "WindowSeconds": 60
    },
    "Authenticated": {
      "Algorithm": "FixedWindow",
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "UrlCreation": {
      "Algorithm": "TokenBucket",
      "PermitLimit": 20,
      "TokensPerPeriod": 20,
      "ReplenishmentPeriodSeconds": 60
    },
    "ApiKey": {
      "Algorithm": "TokenBucket",
      "PermitLimit": 600,
      "TokensPerPeriod": 600,
      "ReplenishmentPeriodSeconds": 60
    }
  },
  "Redis": {
    "ConnectionString": "",
    "KeyPrefix": "",
    "ConnectTimeoutMilliseconds": 2000,
    "OperationTimeoutMilliseconds": 1000,
    "ConnectRetryCount": 2,
    "ReconnectBaseDelayMilliseconds": 1000,
    "ReconnectMaxDelayMilliseconds": 5000
  },
  "ShortUrlLifecycle": {
    "SoftDeleteRetentionDays": 30
  },
  "PublicUrls": {
    "BaseUrl": ""
  },
  "Identity": {
    "PublicRegistrationEnabled": true,
    "RequireSecureCookies": true,
    "JwtIssuer": "UrlShortener.Api",
    "JwtAudience": "UrlShortener.Client",
    "JwtSigningKeyBase64": "",
    "JwtClockSkewSeconds": 30,
    "AllowedOrigins": [
      "https://localhost:4200",
      "http://localhost:4200"
    ],
    "PasswordRequiredLength": 12,
    "PasswordRequiredUniqueChars": 4,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "AccessTokenLifetimeMinutes": 10,
    "RefreshTokenLifetimeDays": 30,
    "RefreshTokenAbsoluteLifetimeDays": 90
  },
  "Serilog": {
    "MinimumLevel": "Information"
  }
}
